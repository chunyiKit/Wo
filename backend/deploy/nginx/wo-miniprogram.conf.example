# 仅供审查的 trek 接入模板，未安装、未通过线上 nginx -t。
# 未来获准后调整现有 trek 精确 vhost；不能与原 trek 配置重复启用。
# 不修改 wo-backend.conf 的旧 IP/default_server，不移除其私有 CA。
# 证书路径是示例，需沿用现有 trek 证书及续期机制，不能假定线上目录一致。
# 上游端口来自仓库 Wo 模板，实施前须只读确认实际服务监听。
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name trek.chunyi-work.online;

    ssl_certificate /etc/letsencrypt/live/trek.chunyi-work.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/trek.chunyi-work.online/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 25M;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";

    location /api/v1/ {
        proxy_pass http://127.0.0.1:8000;
    }
    # 兼容未来切换域名的 Flutter 视频和 APK；不开放额外公共媒体目录。
    location ~ ^/api/v1/families/[^/]+/plugins/memory/ {
        client_max_body_size 110M;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_request_buffering off;
        proxy_pass http://127.0.0.1:8000;
    }
    location /api/v1/app/ {
        client_max_body_size 210M;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_pass http://127.0.0.1:8000;
    }
    location = / {
        default_type text/plain;
        return 200 "wo backend up — try /api/v1/health\n";
    }
    # 保留现有 trek 的 HTTP/ACME 续期配置；此模板不接管它。
    location / { return 404; }
}
