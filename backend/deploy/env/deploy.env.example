# 复制为同目录 deploy.env 后填写；真实配置被 Git 忽略。
# shell 配置文件，仅加载可信文件。环境变量可覆盖下列值。
WO_SSH_HOST=server.example.com
WO_SSH_USER=ubuntu
WO_APP_DIR=/opt/wo-backend

# 与 config/app.local.json 的 WO_API_BASE_URL 保持一致。
WO_API_BASE_URL=https://api.example.com
WEB_BASE_URL=https://api.example.com

# 私有 CA 签发的服务器证书使用此 IP 作为 SAN（不填示例 IP）。
WO_SERVER_IP=
# WO_CA_CERT=/absolute/path/to/ca.crt
# WO_CERT_DAYS=3650
# WO_RELEASE_TOKEN_FILE=/absolute/path/to/release_token.txt
