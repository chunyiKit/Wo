/* 时间线：月份分组 + 卡片。配色沿用主包 app.wxss 的暖调变量值。
   底部留 180rpx：悬浮「＋」会压在最后一屏的右下角，不留白会挡住最后一张卡。 */
.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 180rpx;
  box-sizing: border-box;
  background: #f8f1e7;
}

.state {
  padding: 120rpx 32rpx;
  text-align: center;
}

.state-text {
  font-size: 28rpx;
  color: #736052;
}

.empty-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #302219;
}

.empty-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #736052;
}

.retry {
  margin: 32rpx auto 0;
  max-width: 240rpx;
}

.head {
  padding: 8rpx 4rpx 20rpx;
}

.head-text {
  font-size: 24rpx;
  color: #9a8878;
}

.month-block {
  margin-bottom: 8rpx;
}

.month {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 24rpx 4rpx 12rpx;
}

.month-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #302219;
}

.month-count {
  font-size: 24rpx;
  color: #9a8878;
}

.card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 2rpx 4rpx rgba(42, 30, 20, 0.04), 0 12rpx 40rpx rgba(42, 30, 20, 0.06);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.author {
  display: flex;
  align-items: center;
}

.avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f1e7db;
}

.avatar-emoji {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: #f1e7db;
  font-size: 24rpx;
}

.author-name {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #302219;
}

.date {
  display: flex;
  align-items: center;
}

.lock {
  margin-right: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #f1e7db;
  font-size: 20rpx;
  color: #8a6f52;
}

.date-text {
  font-size: 24rpx;
  color: #9a8878;
}

.title-row {
  display: flex;
  align-items: baseline;
  margin-top: 20rpx;
}

.mood {
  margin-right: 10rpx;
  font-size: 30rpx;
}

.title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #302219;
  line-height: 1.5;
}

.body {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #5f4c3d;
  /* 列表里只露两行，全文进详情页看。 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.thumbs {
  display: flex;
  margin-top: 20rpx;
}

.thumb {
  width: 200rpx;
  height: 200rpx;
  margin-right: 8rpx;
  border-radius: 16rpx;
  background: #f1e7db;
}

.thumb-more {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1e7db;
}

.thumb-more-text {
  font-size: 28rpx;
  color: #8a6f52;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.meta-item {
  margin-right: 16rpx;
  font-size: 22rpx;
  color: #9a8878;
}

.tail {
  padding: 32rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #9a8878;
}

.tail-hint {
  color: #b3a494;
}

/* ---- P3：新建入口 ---- */

.empty-btn {
  margin: 32rpx auto 0;
  max-width: 320rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  line-height: 100rpx;
  text-align: center;
  border-radius: 50%;
  background: #c4703a;
  color: #fff;
  font-size: 56rpx;
  box-shadow: 0 8rpx 24rpx rgba(122, 66, 30, 0.3);
}
