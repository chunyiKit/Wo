page{background:#160f0d;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}view,button,input,textarea{box-sizing:border-box}.screen{--bg:#160f0d;--elev:#271c17;--tint:#201612;--fg:#fff0db;--muted:#ceb69e;--accent:#f2b779;--soft:#483020;--line:rgba(217,161,106,.2);--money:#3c2a18;--chore:#2d2b21;--memory:#38271d;min-height:100vh;background:var(--bg);color:var(--fg);padding:36rpx 36rpx calc(70rpx + env(safe-area-inset-bottom));}.paper{--bg:#f8f1e7;--elev:#fff;--tint:#efe4d6;--fg:#302219;--muted:#736052;--accent:#a85d2d;--soft:#f2dfc9;--line:rgba(48,34,25,.15);--money:#e8d4a8;--chore:#d6dcc8;--memory:#ddcfc0}.eyebrow{font-size:20rpx;letter-spacing:5rpx;color:var(--accent);margin-bottom:14rpx}.title{font-family:WoSerif,"Songti SC","Noto Serif CJK SC",serif;font-size:52rpx;line-height:1.35;font-weight:600;letter-spacing:2rpx}.subtitle,.muted{color:var(--muted);font-size:24rpx;line-height:1.7}.subtitle{margin:16rpx 0 30rpx}.card{background:var(--elev);border:1rpx solid var(--line);border-radius:40rpx;padding:32rpx;margin:24rpx 0}.section{margin-top:40rpx}.row{display:flex;gap:20rpx;align-items:center}.grow{flex:1;min-width:0}.button,button.button{background:var(--accent);color:var(--bg);border-radius:24rpx;padding:24rpx 30rpx;font-size:28rpx;font-weight:600;line-height:1.5;margin:20rpx 0;border:0}.button::after,.secondary::after{border:0}.button[disabled]{opacity:.5}.secondary,button.secondary{background:var(--tint);color:var(--fg);border:1rpx solid var(--line);border-radius:24rpx;font-size:26rpx;line-height:1.5;padding:20rpx 24rpx;margin:16rpx 0}.field,input.field,textarea.field{display:block;background:var(--tint);border:1rpx solid var(--line);border-radius:20rpx;color:var(--fg);padding:24rpx;margin:16rpx 0;width:100%;min-height:90rpx;font-size:28rpx}.field:focus{border-color:var(--accent)}textarea.field{min-height:180rpx}.empty{padding:64rpx 24rpx;text-align:center;color:var(--muted);line-height:1.8}.error{color:#eea99b;background:rgba(192,57,43,.12);border-radius:20rpx;padding:24rpx;line-height:1.7;margin:20rpx 0}.paper .error{color:#9c3229}.amount{font-size:56rpx;font-variant-numeric:tabular-nums;letter-spacing:-1rpx}.pill{border-radius:999rpx;background:var(--soft);color:var(--accent);font-size:22rpx;padding:10rpx 18rpx;display:inline-block}.fab{position:fixed;right:36rpx;bottom:calc(30rpx + env(safe-area-inset-bottom));background:var(--accent);color:var(--bg);border-radius:30rpx;padding:26rpx 36rpx}.label{display:block;color:var(--muted);font-size:24rpx;margin-top:22rpx}button{white-space:normal}button:focus{outline:2rpx solid var(--accent)}
