<view class="screen {{theme}} chores">
  <view class="eyebrow">A LITTLE CARE, EVERY DAY</view><view class="heading row"><view class="grow"><view class="title">家务活</view><view class="subtitle">一起分担，把家照顾好。</view></view><text class="heading-icon">✳</text></view>
  <view class="card overview row"><view class="grow"><view class="count">{{openCount}}<text> 件待做</text></view><view class="muted">让小事有着落，让彼此轻松一点。</view></view><text class="overview-icon">🧹</text></view>
  <view class="filters row"><button class="filter {{filter === 'open' ? 'active' : ''}}" data-filter="open" bindtap="changeFilter">待做 {{openCount}}</button><button class="filter {{filter === 'done' ? 'active' : ''}}" data-filter="done" bindtap="changeFilter">已完成 {{doneCount}}</button><button class="filter {{filter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="changeFilter">全部</button><view class="grow"/><text wx:if="{{refreshing || pendingIds.length}}" class="muted">{{pendingIds.length ? '保存中…' : '更新中…'}}</text></view>
  <view wx:if="{{loading}}" class="empty">正在整理家务…</view>
  <view wx:if="{{error}}" class="error"><text>{{error}}</text><button class="secondary" bindtap="retry">重新加载</button></view>
  <view wx:if="{{loaded && !visible.length}}" class="card empty"><view class="empty-icon">✧</view><view>{{filter === 'done' ? '还没有已完成的家务' : filter === 'open' ? '现在没有待做家务' : '还没有添加家务'}}</view><view class="muted">{{filter === 'open' ? '享受一下干净舒适的小窝。' : '从一件小事开始，一起照顾这个家。'}}</view></view>
  <view wx:for="{{visible}}" wx:key="id" class="card chore {{item.done ? 'done' : ''}}"><view class="row"><button class="check" disabled="{{pendingIds.length > 0 || submitting}}" data-id="{{item.id}}" bindtap="toggleDone" aria-label="{{item.done ? '撤销完成' : '标记完成'}}">{{item.done ? '✓' : '○'}}</button><text class="chore-emoji">{{item.emoji}}</text><view class="grow" data-id="{{item.id}}" bindtap="openEdit"><view class="chore-name">{{item.title}}</view><view wx:if="{{item.note}}" class="muted note">{{item.note}}</view></view><text wx:if="{{item.recurring}}" class="recurring">每周</text></view><view class="chore-footer row"><member-avatar wx:if="{{item.assigned_to}}" url="{{item.assignee_avatar_url}}" emoji="{{item.assignee_emoji || '👤'}}"/><text class="muted grow">{{item.assignee_name || '还没有指派负责人'}}</text><button class="text-button" disabled="{{pendingIds.length > 0 || submitting}}" data-id="{{item.id}}" bindtap="openEdit">编辑</button><button class="text-button muted" disabled="{{pendingIds.length > 0 || submitting}}" data-id="{{item.id}}" bindtap="deleteChore">删除</button></view></view>
  <button class="button add-button" bindtap="openNew" disabled="{{!loaded || submitting || pendingIds.length > 0}}">＋ 加一件家务</button>
  <view wx:if="{{editor}}" class="modal-mask"><view class="card editor"><view class="row"><view class="section grow">{{editingId ? '编辑家务' : '加一件家务'}}</view><button class="text-button" bindtap="closeEditor" disabled="{{submitting}}">关闭</button></view><view class="muted label">家务名称</view><input class="field" value="{{form.title}}" maxlength="64" placeholder="例如：给阳台的花浇水" bindinput="updateTitle"/><view class="muted label">小图标</view><input class="field emoji-input" value="{{form.emoji}}" maxlength="16" bindinput="updateEmoji"/><view class="muted label">交给谁</view><scroll-view scroll-y="{{true}}" class="members-scroll"><view class="members"><view class="member {{!form.assigned_to ? 'selected' : ''}}" bindtap="selectMember"><view class="unassigned">○</view><text>暂不指派</text></view><view wx:for="{{members}}" wx:key="user_id" class="member {{form.assigned_to === item.user_id ? 'selected' : ''}}" data-id="{{item.user_id}}" bindtap="selectMember"><member-avatar url="{{item.avatar_url}}" emoji="{{item.avatar_emoji}}"/><text>{{item.display_name}}</text></view></view></scroll-view><view class="row recurring-switch"><view class="grow"><view>每周重复</view><view class="muted">保留重复标记，可随时完成或重新打开</view></view><switch checked="{{form.recurring}}" bindchange="toggleRecurring" color="#81a98d"/></view><view class="muted label">备注</view><textarea class="field note-input" value="{{form.note}}" maxlength="500" placeholder="补充一点小细节（选填）" bindinput="updateNote"/><button class="button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{submitting ? '保存中…' : '保存家务'}}</button></view></view>
</view>
