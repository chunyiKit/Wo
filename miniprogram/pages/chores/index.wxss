.chores { padding-bottom: 150rpx; }.heading { margin: 20rpx 0 38rpx; }.heading-icon { color: #81a98d; font-size: 80rpx; }.overview { background: linear-gradient(135deg,rgba(129,169,141,.2),rgba(129,169,141,.06)); padding: 36rpx; }.count { font-size: 64rpx; margin-bottom: 12rpx; }.count text { font-size: 27rpx; }.overview-icon { font-size: 64rpx; padding-left: 20rpx; }.filters { margin: 32rpx 0; gap: 12rpx; }.filter { color: inherit; font-size: 24rpx; line-height: 2.4; padding: 0 22rpx; margin: 0; background: rgba(129,169,141,.07); border: 1rpx solid rgba(129,169,141,.18); border-radius: 16rpx; }.filter.active { background: rgba(129,169,141,.23); border-color: #81a98d; }.filter::after { border: 0; }.chore { margin-bottom: 20rpx; }.check { background: transparent; padding: 0; width: 54rpx; margin: 0 16rpx 0 0; color: #81a98d; font-size: 48rpx; line-height: 1.2; }.check::after { border: 0; }.chore-emoji { font-size: 40rpx; margin-right: 20rpx; }.chore-name { font-size: 30rpx; font-weight: 600; }.done .chore-name { text-decoration: line-through; opacity: .6; }.note { margin-top: 10rpx; white-space: pre-wrap; overflow-wrap: anywhere; }.recurring { font-size: 21rpx; padding: 6rpx 12rpx; background: rgba(129,169,141,.16); border-radius: 8rpx; color: #81a98d; margin-left: 12rpx; }.chore-footer { border-top: 1rpx solid rgba(155,131,103,.14); margin-top: 22rpx; padding-top: 18rpx; gap: 12rpx; }.text-button { font-size: 23rpx; padding: 0 12rpx; margin: 0; background: transparent; color: inherit; line-height: 2; }.text-button::after { border: 0; }.add-button { margin-top: 30rpx; }.empty-icon { font-size: 60rpx; color: #81a98d; margin-bottom: 14rpx; }.empty .muted { margin-top: 12rpx; }.modal-mask { position: fixed; inset: 0; z-index: 50; background: rgba(0,0,0,.58); display: flex; align-items: flex-end; padding: 22rpx; box-sizing: border-box; }.editor { width: 100%; max-height: 86vh; overflow: auto; padding-bottom: calc(30rpx + env(safe-area-inset-bottom)); }.label { margin: 22rpx 0 12rpx; }.emoji-input { width: 100rpx; }.members-scroll { max-height: 260rpx; }.members { display: flex; flex-wrap: wrap; gap: 16rpx; }.member { display: flex; align-items: center; gap: 12rpx; font-size: 25rpx; padding: 12rpx 18rpx; border-radius: 16rpx; border: 1rpx solid rgba(129,169,141,.2); }.member.selected { border-color: #81a98d; background: rgba(129,169,141,.16); }.unassigned { width: 48rpx; text-align: center; font-size: 40rpx; }.recurring-switch { margin: 28rpx 0; }.recurring-switch .muted { font-size: 22rpx; margin-top: 8rpx; }.note-input { width: 100%; height: 120rpx; margin-bottom: 28rpx; box-sizing: border-box; }
