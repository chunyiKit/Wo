.mast{margin-bottom:30rpx}.brand{font-family:WoSerif,"Songti SC",serif;font-size:68rpx;line-height:1.1}.theme-toggle,.account-toggle{color:var(--fg);background:transparent;font-size:22rpx;padding:12rpx 16rpx;border:1rpx solid var(--line);border-radius:99rpx;line-height:1.4;margin:0}.theme-toggle::after,.account-toggle::after{border:0}.hero{height:580rpx;position:relative;border-radius:44rpx;overflow:hidden;background:#533021}.hero-image,.hero-shade{position:absolute;inset:0;width:100%;height:100%}.hero-shade{background:linear-gradient(180deg,rgba(34,17,13,.05),rgba(22,15,13,.2) 35%,rgba(22,15,13,.9))}.hero-content{position:absolute;bottom:46rpx;left:40rpx;right:30rpx;color:#fff0db}.hero-kicker{font-size:18rpx;letter-spacing:5rpx;color:#e9c9a7;margin-bottom:20rpx}.hero-title{font-family:WoSerif,"Songti SC",serif;font-size:60rpx;line-height:1.4;letter-spacing:3rpx}.chevron{font-family:sans-serif;font-size:28rpx}.hero-slogan{font-size:24rpx;color:#e9c9a7;line-height:1.8;margin-top:20rpx}.people{margin:24rpx 0 50rpx;gap:16rpx}.faces{display:flex;gap:8rpx}.small{font-size:40rpx}.chapter{margin-bottom:30rpx}.chapter-no{font-size:20rpx;color:var(--muted);letter-spacing:3rpx}.tile{border-radius:40rpx;padding:36rpx;position:relative;margin-bottom:24rpx;border:1rpx solid var(--line);overflow:hidden;min-height:240rpx;background:var(--memory)}.tile.accounting{background:var(--money)}.tile.chore{background:var(--chore)}.tile-en{font-size:18rpx;letter-spacing:4rpx;color:var(--muted);margin-bottom:18rpx}.tile-name{font-family:WoSerif,"Songti SC",serif;font-size:44rpx}.tile-desc{font-size:24rpx;margin-top:22rpx;color:var(--muted)}.tile-icon{position:absolute;right:44rpx;top:32rpx;font-size:72rpx;opacity:.35;font-weight:200}.tile-arrow{position:absolute;right:36rpx;bottom:32rpx;font-size:36rpx;color:var(--accent)}.closing{text-align:center;margin-top:52rpx;color:var(--muted);font-size:22rpx;letter-spacing:3rpx}.closing-rule{width:48rpx;height:2rpx;background:var(--accent);margin:30rpx auto}
.family-entry .card{margin-top:30rpx}.invite-input{letter-spacing:4rpx;text-transform:uppercase}.invitation-preview{border-top:1rpx solid var(--line);margin-top:28rpx;padding-top:26rpx}.preview-name{font-size:34rpx;margin-bottom:12rpx;font-weight:600}.migration-note{padding:4rpx 12rpx 24rpx;font-size:22rpx}.setup-title{font-family:WoSerif,"Songti SC",serif;font-size:32rpx;margin-bottom:14rpx}.setup-copy{margin-bottom:20rpx}.setup-row{padding:16rpx 0;border-top:1rpx solid var(--line);font-size:28rpx}.setup-icon{font-size:36rpx;width:50rpx;color:var(--accent);text-align:center}.setup-row button.enable-button{margin:0;padding:12rpx 24rpx;font-size:24rpx}.theme-toggle[disabled],.enable-button[disabled]{opacity:.5}
