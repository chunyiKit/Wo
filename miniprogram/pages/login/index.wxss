.screen{padding-top:80rpx}.small{font-size:38rpx}.consent{font-size:22rpx;line-height:1.8;color:var(--muted);display:block;margin:28rpx 0}.consent checkbox{transform:scale(.8);transform-origin:left center}.text-button{background:transparent;color:var(--accent);font-size:24rpx;margin:14rpx 0;padding:10rpx;line-height:1.6}.text-button::after{border:0}.secret{display:block;font-family:monospace;word-break:break-all;font-size:30rpx;line-height:1.7;padding:24rpx;background:var(--tint);border:1rpx dashed var(--accent);border-radius:16rpx}.footnote{text-align:center;color:var(--muted);font-size:22rpx;letter-spacing:3rpx;margin:60rpx 0}
