<view class="screen {{theme}}">
  <view class="eyebrow">WO · A PLACE FOR US</view><view class="title">日常有归处。</view><view class="subtitle">一个小小的窝，装下我们认真过的生活。</view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
  <view wx:if="{{secret}}" class="card"><view class="eyebrow">KEEP IT SAFE</view><view class="title small">请保存你的恢复码</view><view class="subtitle">仅此一次显示，请抄写并保存在私人安全位置。可用于重设密码，使用后作废；有效期一年。离开本页将隐藏。</view><text class="secret" selectable="{{true}}">{{secret}}</text><button class="button" bindtap="home">我已安全保存，进入窝</button></view>
  <view wx:elif="{{account}}" class="card"><view class="row"><member-avatar url="{{account.avatar_url}}" emoji="{{account.avatar_emoji}}"/><view class="grow"><view>{{account.display_name}}</view><view class="muted">已登录窝账号</view></view></view><button class="button" bindtap="home">回到我们的日常</button><label class="label">验证当前密码，重新生成恢复码</label><input class="field" password="{{true}}" maxlength="64" value="{{password}}" data-field="password" bindinput="input" placeholder="当前账号密码"/><button class="secondary" bindtap="recovery" disabled="{{busy || !password}}" loading="{{busy}}">生成新的恢复码</button><button class="secondary" bindtap="logout" disabled="{{busy}}">退出当前设备</button><button class="secondary" bindtap="logout" data-all="true" disabled="{{busy}}">退出所有设备</button></view>
  <view wx:else class="card">
    <view class="title small">{{mode==='bind'?'把原来的窝带过来':mode==='register'?'遇见新的日常':mode==='reset'||mode==='phone-reset'?'找回你的窝':'欢迎回家'}}</view>
    <view wx:if="{{mode==='bind'}}" class="subtitle">绑定会验证原账号密码，并保留原家庭与记录。手机号仅用于查找原账号，不能作为合并凭据。</view>
    <view wx:if="{{mode==='register'}}" class="subtitle">新账号需要设置独立密码并保存恢复码。已有账号请返回绑定，避免建立两个账号。</view>
    <block wx:if="{{mode==='bind'||mode==='phone-reset'}}"><label class="label">原账号手机号</label><input class="field" type="number" maxlength="11" value="{{phone}}" data-field="phone" bindinput="input" placeholder="原 App 使用的手机号"/></block>
    <block wx:if="{{mode==='register'}}"><label class="label">昵称</label><input class="field" maxlength="24" value="{{displayName}}" data-field="displayName" bindinput="input" placeholder="想让家人怎样称呼你"/></block>
    <block wx:if="{{mode==='bind'||mode==='register'}}"><label class="label">{{mode==='bind'?'原账号密码':'设置密码（6–64 位）'}}</label><input class="field" password="{{true}}" maxlength="64" value="{{password}}" data-field="password" bindinput="input" placeholder="请输入密码"/></block>
    <block wx:if="{{mode==='reset'||mode==='phone-reset'}}"><label class="label">一次性恢复码</label><input class="field" password="{{true}}" maxlength="128" value="{{recoveryCode}}" data-field="recoveryCode" bindinput="input" placeholder="已保存的恢复码"/><label class="label">新密码（6–64 位）</label><input class="field" password="{{true}}" maxlength="64" value="{{newPassword}}" data-field="newPassword" bindinput="input" placeholder="设置新密码"/><view class="subtitle">成功后退出所有旧会话。没有恢复码的账号需通过管理员可信核验流程，不能凭同手机号直接合并。</view></block>
    <checkbox-group bindchange="consent"><label class="consent"><checkbox value="yes" checked="{{consent}}" color="#A85D2D"/>我已阅读并同意：微信身份仅用于登录绑定；家庭记录与图片仅按家庭权限访问，图片在我选择并提交后上传。此版本不请求微信手机号或通讯录。</label></checkbox-group>
    <button class="button" bindtap="submit" disabled="{{busy}}" loading="{{busy}}">{{mode==='login'?'微信登录':mode==='bind'?'验证原密码并绑定微信':mode==='register'?'创建账号并绑定微信':'验证恢复码并重设密码'}}</button>
    <view class="alternatives"><button wx:if="{{mode!=='bind'}}" class="secondary" data-mode="bind" bindtap="select" disabled="{{busy}}">已有窝账号，绑定微信</button><button wx:if="{{mode!=='register'}}" class="secondary" data-mode="register" bindtap="select" disabled="{{busy}}">第一次来，创建账号</button><button wx:if="{{mode!=='login'}}" class="secondary" data-mode="login" bindtap="select" disabled="{{busy}}">返回微信登录</button><button wx:if="{{mode!=='phone-reset'}}" class="text-button" data-mode="phone-reset" bindtap="select" disabled="{{busy}}">找回原手机号账号</button><button wx:if="{{mode!=='reset'}}" class="text-button" data-mode="reset" bindtap="select" disabled="{{busy}}">找回当前微信账号</button></view>
  </view>
  <view class="footnote">我们的生活，留在我们之间。</view>
</view>
