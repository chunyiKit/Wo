.accounting { padding-bottom: 150rpx; }
.heading { margin: 20rpx 0 38rpx; }.heading-icon { font-size: 80rpx; color: #bd9366; }.month-picker { justify-content: space-between; padding: 22rpx 0; }.summary { background: linear-gradient(135deg,rgba(189,147,102,.22),rgba(189,147,102,.06)); padding: 38rpx; }.total { font-size: 82rpx; letter-spacing: -3rpx; margin: 18rpx 0; }.currency { font-size: 38rpx; margin-right: 12rpx; }.split text { margin-left: 26rpx; }.summary-bottom { margin-top: 34rpx; border-top: 1rpx solid rgba(155,131,103,.22); padding-top: 28rpx; }.stat { font-size: 31rpx; margin-top: 10rpx; }.budget-button { color: inherit; font-size: 24rpx; background: transparent; border: 1rpx solid rgba(155,131,103,.35); }.expense { margin-bottom: 20rpx; }.category-emoji { font-size: 44rpx; margin-right: 22rpx; }.expense-name { font-size: 29rpx; margin-bottom: 10rpx; }.expense-money { font-size: 29rpx; white-space: nowrap; }.expense-footer { margin-top: 24rpx; padding-top: 18rpx; border-top: 1rpx solid rgba(155,131,103,.14); gap: 12rpx; }.text-button { font-size: 23rpx; padding: 0 12rpx; margin: 0; background: transparent; color: inherit; line-height: 2; }.text-button::after { border: 0; }.add-button { margin-top: 30rpx; }.empty-icon { font-size: 60rpx; margin-bottom: 14rpx; color: #bd9366; }.empty .muted { margin-top: 12rpx; }.notice { padding: 10rpx 0 20rpx; }.modal-mask { position: fixed; inset: 0; z-index: 50; background: rgba(0,0,0,.58); display: flex; align-items: flex-end; padding: 22rpx; box-sizing: border-box; }.editor { width: 100%; max-height: 86vh; overflow: auto; padding-bottom: calc(30rpx + env(safe-area-inset-bottom)); }.label { margin: 22rpx 0 12rpx; }.money-input { font-size: 40rpx; height: 84rpx; }.category-scroll { max-height: 250rpx; }.categories { display: flex; flex-wrap: wrap; gap: 14rpx; }.category { font-size: 25rpx; border: 1rpx solid rgba(155,131,103,.3); border-radius: 14rpx; padding: 14rpx 18rpx; }.category.selected { border-color: #bd9366; background: rgba(189,147,102,.2); }.budget-switch { margin: 28rpx 0; }.budget-switch .muted { font-size: 22rpx; margin-top: 8rpx; }
