<view class="screen {{theme}} accounting">
  <view class="eyebrow">OUR LITTLE LEDGER</view>
  <view class="heading row"><view class="grow"><view class="title">一起记账</view><view class="subtitle">把日子里的小开销，认真收好。</view></view><text class="heading-icon">◔</text></view>
  <picker mode="date" fields="month" value="{{month}}" bindchange="changeMonth"><view class="month-picker row"><text>{{month}} 月</text><text class="muted">切换月份 ⌄</text></view></picker>
  <view wx:if="{{loading}}" class="empty">正在整理账本…</view>
  <view wx:if="{{error}}" class="error"><text>{{error}}</text><button class="secondary" bindtap="retry">重新加载</button></view>
  <block wx:if="{{loaded}}">
    <view wx:if="{{displayedMonth !== month}}" class="muted notice">当前仍显示 {{displayedMonth}} 的账目{{refreshing ? '，正在更新…' : '，请重试刷新'}}</view>
    <view class="card summary"><view class="muted">{{displayedMonth}} · 家庭支出</view><view class="total"><text class="currency">¥</text>{{total}}</view><view class="split muted">预算内 ¥{{budgeted}} <text>预算外 ¥{{excluded}}</text></view><view class="summary-bottom row"><view class="grow"><view class="muted">每月预算</view><view class="stat">{{budget === '未设置' ? budget : '¥' + budget}}</view></view><view class="grow"><view class="muted">本月剩余</view><view class="stat">{{remaining === '—' ? remaining : '¥' + remaining}}</view></view><button class="budget-button" bindtap="openBudget">设置</button></view></view>
    <view class="section row"><text class="grow">支出明细</text><text class="muted">{{refreshing ? '更新中…' : items.length + ' 笔'}}</text></view>
    <view wx:if="{{!items.length}}" class="card empty"><view class="empty-icon">✧</view><view>这个月的账本还是空白</view><view class="muted">从今天的一笔小开销开始。</view></view>
    <view wx:for="{{items}}" wx:key="id" class="card expense"><view class="row" data-id="{{item.id}}" bindtap="openEdit"><text class="category-emoji">{{item.categoryEmoji}}</text><view class="grow"><view class="expense-name">{{item.note || item.categoryLabel}}</view><view class="muted">{{item.categoryLabel}} · {{item.date}} <text wx:if="{{item.exclude_from_budget}}">· 预算外</text></view></view><text class="expense-money">− ¥{{item.money}}</text></view><view class="expense-footer row"><member-avatar url="{{item.creator_avatar_url}}" emoji="{{item.creator_emoji || '👤'}}"/><text class="muted grow">{{item.creator_name || '家庭成员'}} 记录</text><button class="text-button" data-id="{{item.id}}" bindtap="openEdit" disabled="{{submitting}}">编辑</button><button class="text-button muted" data-id="{{item.id}}" bindtap="deleteExpense" disabled="{{submitting}}">删除</button></view></view>
  </block>
  <button class="button add-button" bindtap="openNew" disabled="{{!loaded || submitting}}">＋ 记一笔</button>
  <view wx:if="{{editor}}" class="modal-mask"><view class="card editor"><view class="row"><view class="section grow">{{editingId ? '编辑支出' : '记一笔'}}</view><button class="text-button" bindtap="closeEditor" disabled="{{submitting}}">关闭</button></view><view class="muted label">金额（元）</view><input class="field money-input" type="digit" maxlength="13" placeholder="0.00" value="{{form.amount}}" data-field="amount" bindinput="updateField"/><view class="muted label">分类</view><scroll-view scroll-y="{{true}}" class="category-scroll"><view class="categories"><view wx:for="{{categories}}" wx:key="code" class="category {{form.category === item.code ? 'selected' : ''}}" data-code="{{item.code}}" bindtap="selectCategory">{{item.emoji}} {{item.label}}</view></view></scroll-view><view class="muted label">备注</view><input class="field" maxlength="200" placeholder="这笔花在了哪里？" value="{{form.note}}" data-field="note" bindinput="updateField"/><view class="row budget-switch"><view class="grow"><view>预算外支出</view><view class="muted">仍计入本月支出，不扣减预算</view></view><switch checked="{{form.exclude_from_budget}}" bindchange="toggleExclude" color="#bd9366"/></view><button class="button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{submitting ? '保存中…' : '保存这笔支出'}}</button></view></view>
  <view wx:if="{{budgetEditor}}" class="modal-mask"><view class="card editor"><view class="section">设置每月预算</view><view class="muted label">适用于每个月，只扣减预算内支出。</view><input class="field money-input" type="digit" maxlength="13" value="{{budgetInput}}" bindinput="updateBudget" placeholder="输入预算金额"/><button class="button" loading="{{budgetSubmitting}}" disabled="{{budgetSubmitting}}" bindtap="saveBudget">保存预算</button><button class="secondary" disabled="{{budgetSubmitting}}" bindtap="closeBudget">取消</button></view></view>
</view>
