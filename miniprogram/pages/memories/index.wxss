.page-heading{padding:24rpx 0 30rpx}.eyebrow{font-size:19rpx;letter-spacing:4rpx;color:var(--muted);margin-bottom:18rpx}.actions{margin-bottom:24rpx}.draft-notice{font-size:24rpx;color:var(--muted);margin-bottom:26rpx;line-height:1.7}.editor{margin-bottom:38rpx;padding:30rpx}.editor-title{font-size:32rpx;font-weight:600}.text-button{font-size:25rpx;background:transparent;color:var(--muted);border:0;padding:8rpx 16rpx;line-height:1.7;margin:0}.text-button::after,.remove-image::after,.add-image::after{border:0}.editor .field{margin-top:24rpx}.body-input{box-sizing:border-box;min-height:160rpx;width:100%}.privacy-note{font-size:23rpx;line-height:1.8;margin:18rpx 0}.photo-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10rpx;margin-top:24rpx}.photo-slot{position:relative;aspect-ratio:1;border-radius:16rpx;overflow:hidden;background:rgba(160,140,128,.12)}.photo{width:100%;height:100%;display:block}.photo-placeholder{height:100%;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:20rpx}.add-image{aspect-ratio:1;margin:0;padding:0;border-radius:16rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(170,140,110,.10);color:var(--muted);font-size:25rpx;line-height:1.8}.image-count{font-size:21rpx;opacity:.7}.remove-image{position:absolute;top:5rpx;right:5rpx;padding:0 12rpx;margin:0;background:rgba(0,0,0,.62);color:white;font-size:23rpx;line-height:40rpx;border-radius:20rpx;min-width:40rpx}.discard{margin:16rpx auto 0}.timeline{border-left:1rpx solid rgba(160,140,128,.28);margin:26rpx 0 0 14rpx;padding-left:32rpx}.moment{position:relative;padding-bottom:34rpx}.date-dot{position:absolute;left:-40rpx;top:8rpx;width:14rpx;height:14rpx;border-radius:50%;background:#cf996c;box-shadow:0 0 0 7rpx rgba(207,153,108,.1)}.date-label{font-size:24rpx;color:var(--muted);letter-spacing:2rpx;margin-bottom:18rpx}.memory-card{padding:28rpx}.author-row{gap:16rpx;margin-bottom:22rpx}.author-name{font-size:24rpx;color:var(--muted)}.visibility-tag{font-size:20rpx;color:var(--muted);border:1rpx solid rgba(160,140,128,.2);padding:5rpx 12rpx;border-radius:18rpx}.moment-title{font-size:32rpx;font-weight:600;line-height:1.5}.moment-body{font-size:26rpx;line-height:1.9;white-space:pre-wrap;margin-top:12rpx;opacity:.8}.list-footnote{text-align:center;font-size:22rpx;padding:4rpx 0 28rpx}.empty-icon{font-size:64rpx;color:#cf996c;margin-bottom:12rpx}.refresh-error{font-size:23rpx;margin-bottom:20rpx}
