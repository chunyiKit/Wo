<view class="page">
  <view class="head">
    <text class="title">注册 Wo 账号</text>
    <text class="sub">注册后会自动绑定这个微信，之后打开小程序就能直接进入</text>
  </view>

  <view class="card">
    <view class="field">
      <text class="label">手机号</text>
      <input
        class="input"
        type="number"
        maxlength="11"
        placeholder="11 位手机号"
        placeholder-class="ph"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="divider"></view>

    <view class="field">
      <text class="label">密码</text>
      <input
        class="input"
        password
        maxlength="64"
        placeholder="至少 6 位"
        placeholder-class="ph"
        value="{{password}}"
        bindinput="onPasswordInput"
      />
    </view>

    <view class="divider"></view>

    <view class="field">
      <text class="label">确认密码</text>
      <input
        class="input"
        password
        maxlength="64"
        placeholder="再输入一次密码"
        placeholder-class="ph"
        value="{{confirm}}"
        bindinput="onConfirmInput"
        bindconfirm="submit"
      />
    </view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view
    class="btn-primary {{loading ? 'disabled' : ''}} submit"
    bindtap="submit"
  >{{loading ? '处理中…' : '注册并绑定'}}</view>

  <!-- 底部小字：切换回登录。整行居中（见 .switch），中间那段才是可点的 -->
  <view class="switch">
    <text>已经有 Wo 账号？</text><text class="switch-link" bindtap="goLogin">去登录</text>
  </view>
</view>
